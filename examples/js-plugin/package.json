{
  "name": "restheart-example-js-plugins",
  "version": "1.0.0",
  "description": "example plugins for RESTHeart, written in TypeScript on restheart:sdk",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@restheart/sdk": "^9.14.0",
    "typescript": "^5.6.0"
  },
  "author": "Andrea Di Cesare andrea@softinstigate.com",
  "license": "Apache-2.0",
  "rh:spi": 1,
  "rh:services": [
    "hello.mjs",
    "sub/hello.mjs",
    "users.mjs",
    "http-client.mjs",
    "webhook.mjs",
    "require-module-service.mjs"
  ],
  "rh:interceptors": [
    "hello-interceptor.mjs",
    "mongo-get-doc-interceptor.mjs",
    "mongo-post-coll-interceptor.mjs"
  ]
}
