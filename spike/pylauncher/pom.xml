<?xml version="1.0" encoding="UTF-8"?>
<!-- Resolves a GraalPy JVM launcher classpath matching restheart-polyglot's GraalPy version.
     ../../mvnw -f spike/pylauncher/pom.xml dependency:copy-dependencies -DoutputDirectory=target/lib -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.restheart.spike</groupId>
  <artifactId>pylauncher</artifactId>
  <version>1</version>
  <packaging>pom</packaging>
  <properties><graalpy.version>25.1.3</graalpy.version></properties>
  <dependencies>
    <dependency><groupId>org.graalvm.python</groupId><artifactId>python-language</artifactId><version>${graalpy.version}</version></dependency>
    <dependency><groupId>org.graalvm.python</groupId><artifactId>python-resources</artifactId><version>${graalpy.version}</version></dependency>
    <dependency><groupId>org.graalvm.python</groupId><artifactId>python-launcher</artifactId><version>${graalpy.version}</version></dependency>
    <dependency><groupId>org.graalvm.truffle</groupId><artifactId>truffle-runtime</artifactId><version>${graalpy.version}</version></dependency>
  </dependencies>
</project>
