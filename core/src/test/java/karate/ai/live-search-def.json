{
    "aggrs": [
        {
            "uri": "semantic-search",
            "type": "pipeline",
            "stages": [
                { "$vectorSearch": {
                    "index": "live_vectors",
                    "path": "embedding",
                    "queryVector": { "$vectorize": { "$var": "q" } },
                    "numCandidates": 10,
                    "limit": 3
                }}
            ],
            "rerank": {
                "model": "rerank-2.5",
                "query": { "$var": "q" },
                "topK": 2
            }
        }
    ]
}
